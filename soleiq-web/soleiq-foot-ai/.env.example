# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — keys committed here would be visible to anyone
# with repo access, which defeats the purpose.

# Anthropic API key for the foundation-model second-opinion layer.
# Get one at https://console.anthropic.com/settings/keys
# Leave blank or comment out to disable the second-opinion call without
# editing config.yaml — the calibrated classifier still serves on its own.
ANTHROPIC_API_KEY=sk-ant-replace-me
