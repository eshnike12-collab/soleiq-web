# Copy this file to `.env.local` and fill in values from your Supabase project.
# Both values are safe to expose in browser code (they're public-by-design).
# RLS on the schema enforces actual access control.

# Canonical origin used to build links inside auth emails (password reset,
# signup confirmation). Optional locally — falls back to the current origin —
# but set it in production so preview deployments still send links to the real
# app. Must match a Redirect URL in Supabase → Authentication → URL
# Configuration. No trailing slash.
# NEXT_PUBLIC_SITE_URL=https://app.soleiqhealth.com

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY
# Legacy projects may use this variable instead:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Without the Supabase values, hospital persistence is unavailable and the
# patient capture remains device-local.

# Server only. Never prefix this key with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=YOUR-ANTHROPIC-API-KEY
# Optional vision-capable model override. Defaults to claude-sonnet-4-6.
# ANTHROPIC_VISION_MODEL=claude-sonnet-4-6

# Server only. Restricted to private media infrastructure and queue workers.
# Never use this for ordinary clinical reads.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVER-ONLY-SERVICE-ROLE-KEY

# ---------------------------------------------------------------------------
# Email (Resend) — server only, never prefix these with NEXT_PUBLIC_.
#
# Without RESEND_API_KEY the app still works: sends are skipped and logged
# rather than failing, so local development needs no mail account. Report
# release and care-circle grants never depend on an email being delivered.
# ---------------------------------------------------------------------------

# From https://resend.com/api-keys
RESEND_API_KEY=

# Must be a verified sender on the domain connected in Resend.
EMAIL_FROM=SoleIQ Health <reports@soleiqhealth.com>

# Canonical origin used to build links inside emails. An email is read outside
# any request context, so this cannot be inferred — a preview-deployment origin
# here would send patients somewhere that is not their app. No trailing slash.
APP_BASE_URL=https://app.soleiqhealth.com

# Shared secret for the daily weekly-check reminder cron
# (/api/cron/rescan-reminders). Vercel Cron sends it as
# `Authorization: Bearer <value>`. Generate with: openssl rand -hex 32
#
# FAIL CLOSED: with this unset the endpoint refuses EVERY request, including
# Vercel's own. That is deliberate — the route mass-mails patients, so an
# unauthenticated caller must never reach the send loop. Leaving it blank
# costs you reminder emails; the in-app reminder card is unaffected.
CRON_SECRET=

# ---------------------------------------------------------------------------
# 3D scan — reconstruction service (soleiq-foot-ai)
#
# The BROWSER calls this directly: a scan is a video blob held in the tab, and
# proxying it through a Next route would upload it twice. Hence NEXT_PUBLIC_.
#
# MUST be set in production. Unset, the 3D scan tab refuses to start a capture
# and says so, rather than POSTing the patient's video to 127.0.0.1 — their own
# phone — where nothing is listening. It also has to be https:// in production:
# an https:// page is not permitted to fetch http://, so a plain-http service
# is blocked by the browser before the request leaves the tab.
#
# Locally this can be left unset; development falls back to the loopback
# address `make serve` binds to.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_FOOT_AI_URL=https://scan.soleiqhealth.com
